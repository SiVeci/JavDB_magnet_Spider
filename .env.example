# 复制为 .env 后按需修改：cp .env.example .env

# 发布版本号，会写入镜像的 JAVDB_SPIDER_VERSION（仅本地 build 时生效）。
JAVDB_SPIDER_VERSION=compose-local

# 主程序 WebUI 对外端口。
SPIDER_PORT=8000

# WebUI/API 访问令牌：必填。前端登录页用它换取访问权限，留空会导致所有 /api 401。
# 生成示例：openssl rand -hex 32
JAVDB_AUTH_TOKEN=change-me

# 主程序与 Auth Browser Service 之间的共享令牌。
# 留空则不鉴权（仅限完全私有网络）；跨机器/公网部署务必设置。
# 生成示例：openssl rand -hex 32
AUTH_BROWSER_SHARED_TOKEN=

# 登录会话有效期（秒）。
AUTH_BROWSER_SESSION_TTL_SECONDS=900

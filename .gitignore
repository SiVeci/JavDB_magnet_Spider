# ================= Android & Gradle 默认忽略 =================
*.iml
.gradle
/local.properties
/.idea/
.DS_Store
/build
/captures
.externalNativeBuild
.cxx
local.properties

# 忽略 app 模块下的编译产物
/app/build/
/app/*.jks

# ================= Python 忽略 =================
# 字节码缓存
__pycache__/
*.py[cod]
*$py.class

# 虚拟环境
venv/
.venv/
env/
ENV/
spider_core/.venv-test/

# ================= 前端 Vue3+Vite 忽略 =================
# 依赖（构建时安装，不入库）
spider_core/web/node_modules/
# Vite 缓存
spider_core/web/.vite/
# 类型检查缓存
spider_core/web/node_modules/.tmp/
# 注意：frontend_dist/ 是构建产物，本机构建后入库，不在忽略列表

# ================= 爬虫业务隐私数据忽略 =================
spider_core/data/
spider_core/task_config.json
spider_core/status.json
spider_core/checkpoint.json
MANUAL_TEST_PLAN.md
analysis_results.md

.claude/

.gemini/

.agent/
